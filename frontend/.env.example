# SatoshiYields Frontend — environment variables
# Copy this to .env.local for local dev, or set these in Vercel.
#
# This branch (Mainnet-beta) only builds for Stacks mainnet. lib/stacksClient.ts
# and constants/contracts.ts both throw if these are not set correctly.

VITE_NETWORK=mainnet

# Mainnet deployer principal — the single-key wallet that publishes and
# permanently owns vault-v6 and the live adapters (ownership is immutable).
VITE_DEPLOYER_MAINNET=REPLACE_WITH_MAINNET_DEPLOYER

# Public URL of the indexer. Leave empty for local dev (vite proxies /api to
# http://localhost:3001). In Vercel, set to the absolute indexer origin.
# Example: https://satoshi-yield-indexer.onrender.com
VITE_INDEXER_URL=

# Per-protocol adapter contract-name overrides. Default to the live adapters
# (zest-earn-adapter / hermetica-hbtc-adapter). Only set these to override a
# rename. Keep in sync with the indexer's *_ADAPTER_NAME vars.
# VITE_ZEST_ADAPTER=zest-earn-adapter
# VITE_HBTC_ADAPTER=hermetica-hbtc-adapter
