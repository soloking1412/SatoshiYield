# Public TESTNET configuration for the 2026-10-01 candidate deployment.
# Copy to .env.testnet.local and run npm run dev:testnet.
# No private key belongs in the frontend or any VITE_* variable.
VITE_NETWORK=testnet
VITE_DEPLOYER_TESTNET=ST1RHTNPSR0SX6SZC4ZGCPH5W8XS0MRT25NW98QDX
VITE_VAULT_CONTRACT_NAME=vault-v7
VITE_ZEST_ADAPTER=mock-sync-v7
VITE_HBTC_ADAPTER=mock-async-v7
VITE_ENABLE_TESTNET_DEPOSITS=true
VITE_INDEXER_URL=
