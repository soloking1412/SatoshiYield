# Copy this to Devnet.toml before running the fork test:
#   cp settings/Devnet.toml.example settings/Devnet.toml
#
# These are the STANDARD PUBLIC Clarinet devnet mnemonics (the same ones
# `clarinet new` generates) — NOT secrets, no real funds. Devnet.toml itself is
# gitignored so no mnemonic lives in the repo.

[network]
name = "devnet"

[accounts.deployer]
mnemonic = "twice kind fence tip hidden tilt action fragile skin nothing glory cousin green tomorrow spring wrist shed math olympic multiply hip blue scout claw"
balance = 100_000_000_000_000

[accounts.wallet_1]
mnemonic = "sell invite acquire kitten bamboo drastic jelly vivid peace spawn twice guilt pave pen trash pretty park cube fragile unaware remain midnight betray rebuild"
balance = 100_000_000_000_000
