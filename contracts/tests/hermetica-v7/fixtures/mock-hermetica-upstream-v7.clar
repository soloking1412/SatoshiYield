;; Local TOKEN-MOVING semantic model of verified vault-hbtc-v1-2 ABI.
;; Not mainnet source; configurable price, liquidity, failure and blacklist paths.
;; Only redeem (permissionless) and cancel (claim-user only) delete claims,
;; matching the verified source. Cooldown uses burn blocks in this local model. ABI previews return raw uint, claims optional fields.
(define-constant OWNER tx-sender)
(define-data-var price uint u100000000)
(define-data-var cooldown uint u0)
(define-data-var next-id uint u0)
(define-data-var redeem-enabled bool true)
(define-data-var request-enabled bool true)
(define-data-var funding-enabled bool true)
(define-data-var blacklisted bool false)
(define-data-var forced-read-error uint u0)
(define-data-var misreport bool false)
(define-map shares principal uint)
(define-map claims uint {user:principal,shares:uint,share-price:(optional uint),assets:(optional uint),fee:(optional uint),fee-bps:uint,ts:uint,is-express:bool})
(define-public (configure (p uint) (c uint) (r bool) (q bool) (f bool) (b bool))
  (begin (asserts! (is-eq contract-caller OWNER) (err u100))
    (var-set price p) (var-set cooldown c) (var-set redeem-enabled r)
    (var-set request-enabled q) (var-set funding-enabled f) (var-set blacklisted b) (ok true)))
(define-public (set-errors (code uint) (lie bool))
  (begin (asserts! (is-eq contract-caller OWNER) (err u100))
    (var-set forced-read-error code) (var-set misreport lie) (ok true)))
(define-public (slash (amount uint))
  (begin (asserts! (is-eq contract-caller OWNER) (err u100))
    (as-contract (contract-call? .mock-sbtc burn amount tx-sender))))
(define-read-only (preview-deposit (assets uint)) (/ (* assets u100000000) (var-get price)))
(define-read-only (preview-redeem (amount uint)) (/ (* amount (var-get price)) u100000000))
(define-read-only (get-shares (user principal)) (default-to u0 (map-get? shares user)))
(define-read-only (get-claim (id uint))
  (begin (asserts! (is-eq (var-get forced-read-error) u0) (err (var-get forced-read-error)))
    (ok (unwrap! (map-get? claims id) (err u103003)))))
(define-public (deposit (assets uint) (affiliate (optional (buff 64))))
  (let ((amount (preview-deposit assets)))
    (asserts! (not (var-get blacklisted)) (err u103009))
    (asserts! (and (contract-call? .mock-hermetica-state-v7 get-deposit-enabled)
      (contract-call? .mock-hermetica-state-v7 get-vault-enabled)
      (contract-call? .mock-hermetica-hq-v7 get-protocol-enabled)) (err u103009))
    (asserts! (>= assets u100) (err u103002))
    (try! (contract-call? .mock-sbtc transfer assets contract-caller (as-contract tx-sender) none))
    (map-set shares contract-caller (+ (get-shares contract-caller) amount))
    (ok amount)))
(define-public (request-redeem (amount uint) (express bool))
  (let ((id (+ u1 (var-get next-id))) (owned (get-shares contract-caller)))
    (asserts! (var-get request-enabled) (err u103009))
    (asserts! (not (var-get blacklisted)) (err u103009))
    (asserts! (>= amount u100) (err u103002))
    (asserts! (>= owned amount) (err u103008))
    (map-set shares contract-caller (- owned amount))
    (var-set next-id id)
    (map-set claims id {user:contract-caller,shares:amount,share-price:none,assets:none,fee:none,
      fee-bps:(contract-call? .mock-hermetica-state-v7 get-custom-exit-fee contract-caller express),
      ts:(+ burn-block-height (var-get cooldown)),is-express:express})
    (ok id)))
(define-public (fund-claim (id uint))
  (let ((claim (try! (get-claim id))) (assets (preview-redeem (get shares claim)))
        (fee (/ (* assets (get fee-bps claim)) u10000)))
    (asserts! (var-get funding-enabled) (err u103009))
    (asserts! (>= burn-block-height (get ts claim)) (err u103004))
    (asserts! (is-none (get assets claim)) (err u103005))
    (asserts! (> assets u0) (err u103002))
    (asserts! (>= (unwrap-panic (contract-call? .mock-sbtc get-balance (as-contract tx-sender))) assets) (err u103012))
    (map-set claims id (merge claim {assets:(some assets),fee:(some fee),share-price:(some (var-get price))}))
    (ok assets)))
(define-public (redeem (id uint))
  (let ((claim (try! (get-claim id))) (assets (unwrap! (get assets claim) (err u103006)))
        (fee (unwrap-panic (get fee claim))) (net (- assets fee)))
    (asserts! (var-get redeem-enabled) (err u103009))
    (asserts! (not (var-get blacklisted)) (err u103009))
    (asserts! (>= burn-block-height (get ts claim)) (err u103004))
    (try! (as-contract (contract-call? .mock-sbtc transfer net tx-sender (get user claim) none)))
    (if (> fee u0) (try! (as-contract (contract-call? .mock-sbtc transfer fee tx-sender OWNER none))) true)
    (map-delete claims id)
    (ok (if (var-get misreport) (+ net u1) net))))
(define-public (cancel-redeem (id uint))
  (let ((claim (try! (get-claim id))))
    (asserts! (is-eq contract-caller (get user claim)) (err u103008))
    (asserts! (not (var-get blacklisted)) (err u103009))
    (asserts! (is-none (get assets claim)) (err u103005))
    (asserts! (not (get is-express claim)) (err u103009))
    (map-set shares contract-caller (+ (get-shares contract-caller) (get shares claim)))
    (map-delete claims id)
    (ok (get shares claim))))
