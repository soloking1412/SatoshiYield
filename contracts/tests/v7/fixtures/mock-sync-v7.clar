;; TEST ONLY. Configurable token-moving strategy; never a production adapter.
(impl-trait .yield-source-v2.yield-source-v2-trait)
(use-trait token .sip-010-trait.sip-010-trait)
(define-constant OWNER tx-sender)
(define-map balances principal uint)
(define-data-var total uint u0)
(define-data-var payout-bps uint u10000)
(define-data-var dishonest bool false)
(define-data-var paused bool false)
(define-data-var stale bool false)
(define-public (configure (bps uint) (lies bool) (pause bool) (stale-apy bool))
  (begin (asserts! (is-eq contract-caller OWNER) (err u100))
    (asserts! (<= bps u20000) (err u106))
    (var-set payout-bps bps) (var-set dishonest lies) (var-set paused pause) (var-set stale stale-apy) (ok true)))
(define-public (deposit (amount uint) (user principal))
  (begin (asserts! (is-eq contract-caller .vault-v7) (err u103))
    (asserts! (not (var-get paused)) (err u101))
    (map-set balances user amount) (var-set total (+ (var-get total) amount)) (ok amount)))
(define-public (withdraw (amount uint) (user principal) (asset <token>))
  (let ((principal-amount (unwrap! (map-get? balances user) (err u105))))
    (asserts! (is-eq contract-caller .vault-v7) (err u103))
    (let ((gross (/ (* principal-amount (var-get payout-bps)) u10000)))
      (if (and (> gross u0) (not (var-get dishonest)))
        (try! (as-contract (contract-call? asset transfer gross tx-sender .vault-v7 none))) true)
      (map-delete balances user) (var-set total (- (var-get total) principal-amount)) (ok gross))))
(define-read-only (get-apy) (if (var-get stale) (err u107) (ok u400)))
(define-read-only (get-total-deposited) (ok (var-get total)))
(define-read-only (is-paused) (ok (var-get paused)))
(define-read-only (get-shares (user principal)) (default-to u0 (map-get? balances user)))
(define-read-only (preview-deposit (amount uint)) (ok amount))
(define-read-only (preview-withdraw (user principal)) (ok (/ (* (default-to u0 (map-get? balances user)) (var-get payout-bps)) u10000)))
