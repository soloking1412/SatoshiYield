# SatoshiYields Indexer — environment variables (mainnet).
#
# fetchers/chain.ts throws at boot if STACKS_API_URL or DEPLOYER_ADDRESS are
# missing, and index.ts throws if STACKS_NETWORK=mainnet without the full
# oracle key set. Configure all values explicitly on Render.

# HTTP port (Render injects PORT automatically; this is the local-dev fallback)
PORT=3001

# Stacks API
STACKS_NETWORK=mainnet
STACKS_API_URL=https://api.hiro.so

# The mainnet deployer principal (Asigna 2-of-3 multi-sig).
DEPLOYER_ADDRESS=REPLACE_WITH_MAINNET_DEPLOYER

# Cache TTL for the aggregated yield response (seconds)
CACHE_TTL_SECONDS=300

# Comma-separated allowed browser origins. Required on Render; without it,
# defaults to localhost only and the production frontend gets CORS errors.
# Example: https://satoshiyields.com,https://www.satoshiyields.com
CORS_ALLOWED_ORIGINS=

# Hex private keys (64 chars) for the two oracle signer wallets. These are
# LOW-VALUE keys — they can only call set-apy on the adapters. They cannot
# move user funds, change fees, pause, or transfer ownership.
#
# Generate them by creating two fresh Leather wallet profiles, copying the
# 64-hex private key (NOT the mnemonic) from each, and funding each with
# ~3 STX. Register their SP-addresses via Asigna:
#   <adapter>.set-oracle-at(u0, <oracle-1>)
#   <adapter>.set-oracle-at(u1, <oracle-2>)
# Both keys are required — without ORACLE_PRIVATE_KEY_2 the 2-of-3 consensus
# never commits, on-chain APY goes stale after 720 blocks (~5h), and all
# deposits are blocked by vault-v5.
ORACLE_PRIVATE_KEY=
ORACLE_PRIVATE_KEY_2=
