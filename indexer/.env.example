# SatoshiYields Indexer — environment variables (mainnet).
#
# fetchers/chain.ts throws at boot if STACKS_API_URL or DEPLOYER_ADDRESS are
# missing, and index.ts throws if STACKS_NETWORK=mainnet without the full
# oracle key set when oracle writes are explicitly enabled. Read-only mainnet
# indexing does not require signing keys. Configure the network explicitly.

# HTTP port (Render injects PORT automatically; this is the local-dev fallback)
PORT=3001

# Stacks API
STACKS_NETWORK=mainnet
STACKS_API_URL=https://api.hiro.so

# The mainnet deployer principal (Asigna 2-of-3 multi-sig).
DEPLOYER_ADDRESS=REPLACE_WITH_MAINNET_DEPLOYER

# Per-protocol adapter contract-name overrides. Default to the live adapters
# (zest-earn-adapter / hermetica-hbtc-adapter). The oracle pushes APY to — and
# the API reads state from — these. Only set to override a rename; keep in sync
# with the frontend's VITE_*_ADAPTER vars.
# ZEST_ADAPTER_NAME=zest-earn-adapter
# HBTC_ADAPTER_NAME=hermetica-hbtc-adapter

# Optional: persist the Zest share-price history (used to derive realized APY from
# the vault's on-chain share-price growth) so it survives a restart. Point this at
# a mounted persistent disk. If unset, history is in-memory and re-bootstraps after
# a restart (no new oracle reports until enough fresh history is available).
# ZEST_SHARE_PRICE_FILE=/data/zest-share-price.json

# Cache TTL for the aggregated yield response (seconds)
CACHE_TTL_SECONDS=300

# Read-only by default. Enable only after verifying network, deployed code,
# independent signer operations, and a real observation source. An unavailable
# or divergent feed stops reports; it never refreshes stale/reference APY.
ORACLE_WRITES_ENABLED=false

# Testnet mock faucet only. A separate low-value testnet key is required;
# the public faucet never falls back to either oracle key.
FAUCET_PRIVATE_KEY=
FAUCET_MAX_DAILY_MINTS=200

# Comma-separated allowed browser origins. Required on Render; without it,
# defaults to localhost only and the production frontend gets CORS errors.
# Example: https://satoshiyields.com,https://www.satoshiyields.com
CORS_ALLOWED_ORIGINS=

# Hex private keys (64 chars) for the two oracle signer wallets. These are
# LOW-VALUE keys — they can only call set-apy on the adapters. They cannot
# move user funds, change fees, pause, or transfer ownership.
#
# Generate them by creating two fresh Leather wallet profiles, copying the
# 64-hex private key (NOT the mnemonic) from each, and funding each with
# ~3 STX. Register their SP-addresses via Asigna:
#   <adapter>.set-oracle-at(u0, <oracle-1>)
#   <adapter>.set-oracle-at(u1, <oracle-2>)
# Both keys are required — without ORACLE_PRIVATE_KEY_2 the 2-of-3 consensus
# never commits, on-chain APY goes stale after 2160 blocks (~5.5h), and all
# deposits are blocked by vault-v5. The indexer pushes every 30 min, so the
# on-chain APY stays fresh as long as the (always-on) indexer is running.
ORACLE_PRIVATE_KEY=
ORACLE_PRIVATE_KEY_2=

# Credential endpoint: explicit v7 adapter principals when querying the new vault.
VAULT_VERSION=v6
VAULT_NAME=vault-v6
# VAULT_ADAPTERS=ST....mock-sync-v7,ST....mock-async-v7
