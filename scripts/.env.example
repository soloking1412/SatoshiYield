# SatoshiYields scripts — environment variables
#
# WARNING: scripts/init-v5.js is kept as DOCUMENTATION and as a fallback if
# Asigna multi-sig is ever unavailable. The mainnet deploy and init flow runs
# through the Asigna UI — no PRIVATE_KEY ever touches disk for mainnet.
#
# If you do run init-v5.js (for testnet, or as emergency fallback), set the
# vars below in your shell only — never commit them, never write them to
# files in this repo.
#
#   DEPLOYER=<deployer-SP-address> \
#   PRIVATE_KEY=<hex64> \
#   ORACLE_ADDR=<oracle-1-SP-address> \
#   ORACLE2_ADDR=<oracle-2-SP-address> \
#   NETWORK=mainnet \
#   node scripts/init-v5.js

DEPLOYER=
PRIVATE_KEY=
ORACLE_ADDR=
ORACLE2_ADDR=
NETWORK=mainnet
